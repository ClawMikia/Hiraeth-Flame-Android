<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!-- Use Media3 PlayerControlView as the base controller; Media3 will wire it up to the PlayerView -->
    <androidx.media3.ui.PlayerControlView
        android:id="@+id/exo_controller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:show_timeout="3000" />

    <!-- Fullscreen button that will appear within the controller area.
         The id can be looked up from the PlayerView after it's inflated. -->
    <ImageButton
        android:id="@+id/btn_controller_fullscreen"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/fullscreen"
        android:scaleType="centerInside"
        android:src="@drawable/ic_fullscreen"
        android:tint="@android:color/white"
        android:visibility="gone" />
</FrameLayout>